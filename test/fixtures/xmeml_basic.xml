<?xml version="1.0" encoding="UTF-8"?>
<!-- Plain 25fps XMEML, two back-to-back clips on one video track.
     Everything here is a FRAME COUNT at <timebase>, never seconds:
       <timecode><frame>      sequence start   90000 / 25 = 3600s = 01:00:00:00
       <start>/<end>          record position, relative to the sequence start
       <in>/<out>             offset INTO the source media
       <file><timecode>       the media's own start timecode
     so source timecode is fileTimecode + in, and record timecode is
     sequenceStart + start. Each clip is 100 frames = 4 seconds.
       clip 1: media starts 01:00:00:00, in 0   → src 01:00:00:00
       clip 2: media starts 01:00:00:00, in 250 → src 01:00:10:00 -->
<xmeml version="5">
  <sequence>
    <name>XMEML BASIC</name>
    <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
    <timecode>
      <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
      <frame>90000</frame>
      <displayformat>NDF</displayformat>
    </timecode>
    <media>
      <video>
        <track>
          <clipitem>
            <name>shot_010</name>
            <start>0</start><end>100</end>
            <in>0</in><out>100</out>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <file>
              <name>A001C001.mov</name>
              <pathurl>file:///media/A001C001.mov</pathurl>
              <timecode>
                <frame>90000</frame>
                <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
              </timecode>
            </file>
          </clipitem>
          <clipitem>
            <name>shot_020</name>
            <start>100</start><end>200</end>
            <in>250</in><out>350</out>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <file>
              <name>A001C002.mov</name>
              <pathurl>file:///media/A001C002.mov</pathurl>
              <timecode>
                <frame>90000</frame>
                <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
              </timecode>
            </file>
          </clipitem>
        </track>
      </video>
    </media>
  </sequence>
</xmeml>
