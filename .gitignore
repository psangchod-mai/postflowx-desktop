# Auth config — never commit credentials or dev bypass settings
authConfig.json
electron/authConfig.local.json

# Native build artifacts (Swift build cache — regenerable, machine-specific)
.build/
electron/native/**/.build/

# RED R3D helper build output: the binary links the R3D SDK and r3d_libs/ holds
# RED's redistributable dylibs — do NOT commit vendor SDK binaries. Rebuild on
# the Mac via `npm run build:r3d` (needs R3DSDK_DIR). See electron/native/r3d_helper/.
electron/native/pfx_r3d_decode
electron/native/r3d_libs/

# Built installer / packaging output
companion/output/
*.pkg

# Project-local Python env for the companion test suite (machine-specific).
# Create with: python3 -m venv companion/.venv && companion/.venv/bin/pip install pytest
companion/.venv/
