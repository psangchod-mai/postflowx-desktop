{
  "manifest_version": 3,
  "name": "VisionScope QC",
  "version": "0.2.0",
  "description": "Offline validator for Dolby Vision metadata sidecars (XML/JSON/TXT).",
  "action": {
    "default_title": "VisionScope QC",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
