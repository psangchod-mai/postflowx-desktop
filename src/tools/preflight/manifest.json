{
  "manifest_version": 3,
  "name": "Preflight Validator",
  "short_name": "Preflight",
  "version": "1.0.18",
  "description": "Pre-validate delivery assets (IMF, audio, editorial, NAM, VFX wrap) with a simple non-tech UI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Preflight Validator",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "options_page": "app/index.html"
}